{
  "name": "underwild",
  "version": "0.5.5",
  "description": "Underwild - A 2D sandbox game",
  "main": "platforms/desktop/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "postinstall": "echo No native modules to rebuild",
    "dist": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always",
    "set-version": "node build/scripts/set-version.mjs"
  },
  "devDependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/cli": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "electron-updater": "^6.1.8",
    "liquidfun-wasm": "^7.0.0",
    "ws": "^8.18.0"
  },
  "author": "DillonRGaming",
  "build": {
    "appId": "com.dillonrgaming.underwild",
    "productName": "Underwild",
    "directories": {
      "output": "build/release"
    },
    "files": [
      "**/*",
      "!build/**",
      "!data/**",
      "!*.log",
      "!*-log.txt",
      "!caveman.md",
      "!rules.txt",
      "!.claude/**",
      "!.github/**",
      "!platforms/android/**"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "artifactName": "Underwild-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "DillonRGaming",
        "repo": "Underwild",
        "releaseType": "release"
      }
    ],
    "linux": {
      "target": "AppImage",
      "category": "Game"
    },
    "appImage": {
      "artifactName": "Underwild-${version}.AppImage"
    }
  }
}
