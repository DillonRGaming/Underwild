{
  "name": "underwild",
  "version": "0.5.2",
  "description": "Underwild - A 2D sandbox game",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "postinstall": "echo No native modules to rebuild",
    "dist": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always",
    "set-version": "node scripts/set-version.mjs"
  },
  "devDependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/cli": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "electron-updater": "^6.1.8",
    "ws": "^8.18.0"
  },
  "author": "DillonRGaming",
  "build": {
    "appId": "com.dillonrgaming.underwild",
    "productName": "Underwild",
    "directories": {
      "output": "release"
    },
    "files": [
      "**/*",
      "!worlds/**",
      "!dist/**",
      "!release/**",
      "!concepts/**",
      "!crash-dumps/**",
      "!*.log",
      "!*-log.txt",
      "!underwild-screen.png",
      "!preferences.json",
      "!diag.html",
      "!tree_variants.png",
      "!caveman.md",
      "!rules.txt",
      "!.claude/**",
      "!android/**",
      "!www/**",
      "!scripts/**",
      "!capacitor.config.json"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "artifactName": "Underwild-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "DillonRGaming",
        "repo": "Underwild",
        "releaseType": "release"
      }
    ],
    "linux": {
      "target": "AppImage",
      "category": "Game"
    },
    "appImage": {
      "artifactName": "Underwild-${version}.AppImage"
    }
  }
}
